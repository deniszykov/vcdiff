<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>VCDiff</RootNamespace>
        <TargetFrameworks>netcoreapp3.1;net8.0;</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>6.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>deniszykov.VCDiff</PackageId>
        <Authors>Metric;chyyran;Snowflake Authors, Denis Zykov</Authors>
        <PackageTags>diff;difference;patch;sdch;compare;delta;vcdiff;bsdiff</PackageTags>
        <RepositoryUrl>https://github.com/deniszykov/vcdiff/vcdiff</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Title>vcdiff</Title>
        <Description>A fast, pure C# implementation of the VCDIFF algorithm.</Description>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VCDiff.Tests"/>
    </ItemGroup>

</Project>
